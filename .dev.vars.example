# Backend (Cloudflare Pages Functions) — LOCAL values for `npm run dev:full`.
# Copy to `.dev.vars` (git-ignored) and fill in. wrangler loads these as
# bindings on c.env. In production set the same names as Pages env vars
# (RESEND_API_KEY as a *secret*; the *_CLIENT_IDS are public and may be plain vars).
# See docs/AUTH_SETUP.md.

# --- Dev login (#313) ---
# When 'true', /api/auth/dev/* lists users and signs in as any of them with no
# credential — minting a REAL session, so the guard below stays on (#138). Set
# automatically on PREVIEW deployments (wrangler.toml [env.preview.vars]), whose
# database is anonymised. NEVER set it in production — there it is a complete
# authentication bypass.
# Locally it only shows up with `VITE_DEV_LOGIN=true npm run dev:full`: the
# picker is a build-time flag, and plain `dev:full` builds for production. Plain
# `dev:full` signs in by email OTP instead — the backend returns the code as
# `devCode` and the login screen prints it.
DEV_LOGIN_ENABLED=true

# --- Resend (the only real secret) ---
# Without RESEND_API_KEY the backend logs the OTP and returns it as `devCode`
# instead of sending an email.
RESEND_API_KEY=
# Verified sender. Resend's shared onboarding@resend.dev only delivers to the
# Resend account owner's address; use a verified domain for real users.
RESEND_FROM=Club Ping <onboarding@resend.dev>

# --- OAuth accepted audiences (comma-separated, PUBLIC) ---
# The backend verifies each OIDC id_token's `aud` against these lists.
# Google: include every client id that can issue a token — web + iOS + Android.
GOOGLE_CLIENT_IDS=
# Apple: include the web Service ID *and* the native app bundle id
# (fr.clubping.app), since their id_tokens carry different `aud` values.
APPLE_CLIENT_IDS=

# --- Session guard (#98) ---
# Left OFF (unset) on purpose: with DEV_LOGIN_ENABLED above, local dev holds a
# real session, so the guard can run exactly as it does in production. That is
# the point — a guard bypassed locally means auth mistakes are only ever found
# in production, which is how the logo 401 shipped (#137, #138).
#
# Set it to 'true' only as an escape hatch, e.g. a local database with no users
# to sign in as. Nothing deployed may ever set it: keep it out of wrangler.toml.
# AUTH_GUARD_DISABLED=true
