# D1 exports: real production data (player names, emails, phone numbers).
# Never commit one — take them outside the repo, or leave them ignored here.
d1-backup*.sql
*.d1-export.sql

# Env (local secrets / overrides — *.local also covers .env.local)
.env
!.env.example

# Claude Code. Local state stays out; shared skills come in, because a skill is
# a workflow the repo depends on (.claude/skills/) rather than a personal
# setting. Order matters here: every .claude is ignored first, the one at the
# root is opened back up, its contents are closed again, and skills alone are
# let through. Nested ones — mobile/.claude — are local state only.
**/.claude/
!/.claude/
/.claude/*
!/.claude/skills/
