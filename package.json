{
  "name": "fr.clubping.webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && npx wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply clubping-fr-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply clubping-fr-dev --remote --env preview",
    "db:seed:local": "wrangler d1 execute clubping-fr-prod --local --file=seed.sql",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json && tsc -p tsconfig.functions.test.json",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "CLOUDFLARE_API_TOKEN=$CLUBPING_FR_CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID=$CLUBPING_FR_CLOUDFLARE_ACCOUNT_ID npx wrangler pages deploy --project-name=clubping-fr",
    "db:refresh:dev": "bash scripts/refresh-dev-db.sh"
  },
  "dependencies": {
    "hono": "^4.12.7",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "happy-dom": "^20.8.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^4.0.18",
    "wrangler": "^4.120.0"
  }
}
