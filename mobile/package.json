{
  "name": "fr.clubping.mobile",
  "version": "1.4.1",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:run": "jest",
    "start": "expo start",
    "start:pr": "EXPO_PUBLIC_API_URL=https://pr-${PR:?set PR=<pull request number>}.clubping-fr.pages.dev expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ios:prod": "expo run:ios --configuration Release --device",
    "android:prod": "expo run:android --variant release",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "build:android": "eas build --platform android --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "submit:android": "eas submit --platform android --profile production --latest",
    "store:notes": "npm --prefix .. run store:notes",
    "store:fastlane": "PATH=\"$(brew --prefix ruby)/bin:$PATH\" LANG=fr_FR.UTF-8 LC_ALL=fr_FR.UTF-8 bundle exec fastlane"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.12",
    "expo-calendar": "~57.0.4",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-reanimated": "4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/config-plugins": "~57.0.9",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.12",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
