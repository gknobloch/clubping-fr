{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 n'inclut plus automatiquement les paquets `@types/*` : sans
    // cette ligne, `describe`, `it` et `expect` n'existent plus et chaque
    // fichier de test devient un mur d'erreurs. Les autres types (React, RN)
    // arrivent par les imports des fichiers eux-mêmes et n'ont rien à faire
    // ici — seuls les globaux se déclarent.
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/types": [
        "../src/types/index.ts"
      ],
      "@shared/lib/*": [
        "../src/lib/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
