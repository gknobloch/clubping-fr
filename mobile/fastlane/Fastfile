# ---------------------------------------------------------------------------
# Store release notes (#492)
#
# fastlane is here for one job: the text `eas submit` does not upload. deliver,
# pilot and supply are App Store Connect and Play API clients — no Xcode, no
# macOS runner, no local certificate.
#
# There are deliberately no build lanes. gym and match would replace EAS Build
# with locally managed signing, and increment_build_number would fight
# `appVersionSource: "remote"` in eas.json, which is what makes EAS the single
# owner of versionCode and buildNumber. Building stays `eas build --auto-submit`.
#
# Nothing here promotes anything: iOS stays in TestFlight, Android stays on the
# `internal` track. Sending a release to the public is a separate, manual step.
#
# The lanes are flat rather than in `platform` blocks so that `notes` can call
# all three by name — crossing a platform boundary from a lane needs fastlane's
# internals, and this needs none of it.
# ---------------------------------------------------------------------------

skip_docs

# `__dir__` is "." inside a Fastfile — fastlane evaluates it under a relative
# name — and fastlane chdirs from fastlane/ to mobile/ between parsing a lane and
# running its action. So every path here is expanded once, at parse time, while
# the working directory is still this folder. The metadata paths are not built
# here at all: build-context.json carries them absolute, from the script that
# wrote the files.
FASTLANE_DIR = File.expand_path(__dir__)
MOBILE_DIR = File.expand_path("..", FASTLANE_DIR)
PACKAGE = "fr.clubping.app"
REPO_ROOT = File.expand_path("..", MOBILE_DIR)
CONTEXT = File.join(FASTLANE_DIR, "build-context.json")

# The version and the two build numbers, written by scripts/store-notes.mjs off
# the finished EAS build. Read rather than recomputed: a number guessed here and
# a number guessed there is how notes end up attached to the wrong build.
def build_context
  unless File.exist?(CONTEXT)
    UI.user_error!(
      "#{CONTEXT} absent. Lancez d'abord `npm run store:notes` depuis la racine " \
      "du dépôt — il lit mobile/CHANGELOG.md et interroge EAS pour le build."
    )
  end
  require "json"
  JSON.parse(File.read(CONTEXT))
end

SCREENSHOTS_DIR = File.join(FASTLANE_DIR, "screenshots")

# Whether there is a set of store screenshots to upload, and a hard stop when
# there is half of one (#520).
#
# Three states, because uploading screenshots OVERWRITES what the listing
# already shows. Nothing captured is the ordinary case on a machine that only
# ever ships notes — we leave the live images alone and say so. A full set
# replaces them, which is the point. But one device class on its own is the
# dangerous middle: `overwrite_screenshots` would swap a complete listing for
# half a listing, and a run that captured only `iphone` looks exactly like a
# run that captured both until an App Store page is missing its iPad images.
#
# `*.png` only: Finder drops .DS_Store into any folder somebody has opened, and
# deliver reads whatever it finds.
def ios_screenshots_ready?
  names = Dir[File.join(SCREENSHOTS_DIR, "*", "*.png")].map { |f| File.basename(f) }
  return false if names.empty?

  missing = %w[iphone_ ipad_].reject { |p| names.any? { |n| n.start_with?(p) } }
  unless missing.empty?
    UI.user_error!(
      "Captures incomplètes dans #{SCREENSHOTS_DIR} : aucune image #{missing.join(' ni ')}. " \
      "Téléverser celles-ci remplacerait la fiche complète par une moitié. " \
      "Lancez `npm run store:screenshots -- iphone` et `-- ipad`, ou videz le dossier."
    )
  end
  true
end

# Play's side of the same question. No pairing to check — one device class, and
# supply only touches the locales and types it actually finds.
def android_screenshots_ready?(metadata_path)
  !Dir[File.join(metadata_path, "*", "images", "phoneScreenshots", "*.png")].empty?
end

def read_notes(file)
  UI.user_error!("#{file} absent. Relancez `npm run store:notes`.") unless File.exist?(file)
  File.read(file).strip
end

# App Store Connect authenticates with an API key, not an Apple ID: it is the
# only form that works unattended, and it is separate from the key EAS holds —
# EAS never hands its own back out.
def asc_key
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT].each do |name|
    next unless ENV[name].to_s.empty?

    UI.user_error!("Variable d'environnement #{name} absente. Voir mobile/DISTRIBUTION.md.")
  end
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: true,
    in_house: false,
  )
end

desc "Les identifiants sont-ils là ? À lancer AVANT les builds"
# ---------------------------------------------------------------------------
# Fail in the first second, not after two binaries exist (#519)
#
# The credentials are only reached when a lane needs them, which is after both
# cloud builds, both uploads, and inside the window that closes the moment a
# version goes to review. The 1.4.0 release learned `ASC_KEY_ID` was unset
# exactly there: Play got its notes, the App Store and TestFlight did not, and
# the text those two wanted cannot be added later without a new version number.
#
# Nothing here touches the network. A preflight that needs Apple to answer
# turns "your key is not set" into "something failed", which is the class of
# message this whole issue is about. `app_store_connect_api_key` parses the key
# locally, so a malformed ASC_KEY_CONTENT is caught too — but a well-formed key
# that has been REVOKED still gets through, and so does a Play account missing
# a per-app permission. Both of those surface at upload, with Apple's or
# Google's own wording.
# ---------------------------------------------------------------------------
lane :preflight do
  asc_key # raises, naming the variable, and parses the base64 key content
  UI.success("App Store Connect : clé #{ENV['ASC_KEY_ID']} lisible.")

  key = File.join(MOBILE_DIR, "google-play-service-account.json")
  UI.user_error!("#{key} absent. Voir mobile/DISTRIBUTION.md.") unless File.exist?(key)
  require "json"
  begin
    account = JSON.parse(File.read(key))
  rescue JSON::ParserError => e
    UI.user_error!("#{key} n'est pas un JSON lisible : #{e.message}")
  end
  %w[client_email private_key].each do |field|
    next unless account[field].to_s.empty?

    UI.user_error!("#{key} ne contient pas « #{field} » — ce n'est pas une clé de compte de service.")
  end
  UI.success("Play : compte de service #{account['client_email']}.")

  UI.important(
    "Vérifié sans réseau : les clés sont présentes et lisibles. Une clé révoquée " \
    "ou une permission Play manquante ne se voit qu'au téléversement."
  )
end

desc "Régénère les trois fichiers depuis mobile/CHANGELOG.md"
lane :generate_notes do
  # The script resolves its own paths from its location, so the working
  # directory fastlane happens to be in does not matter.
  sh("node", File.join(REPO_ROOT, "scripts", "store-notes.mjs"))
end

desc "Nouveautés de cette version — App Store, par version"
lane :ios_notes do
  context = build_context
  shots = ios_screenshots_ready?
  unless shots
    UI.important(
      "Aucune capture dans #{SCREENSHOTS_DIR} — la fiche garde ses images actuelles. " \
      "`npm run store:screenshots -- iphone|ipad` si un écran a changé."
    )
  end
  deliver(
    api_key: asc_key,
    app_version: context["version"],
    metadata_path: context["metadataPath"],
    # EAS already uploaded the binary; deliver is here for the text alone.
    skip_binary_upload: true,
    # …but the version record still has to be told WHICH build it is for.
    # Without this, App Store Connect refuses «Add for Review» with "You must
    # choose a build" — a dropdown somebody has to find, on a page that
    # otherwise arrives complete.
    #
    # Named, not «the latest»: build-context.json carries the number read off
    # the finished production build of this exact version, which is the same
    # number testflight_notes attaches its own text to. The two cannot drift.
    #
    # It needs Apple to have FINISHED PROCESSING the upload — five to ten
    # minutes after `eas build --auto-submit` reports success. Run too early,
    # deliver says the build does not exist, which is true and temporary: wait
    # for the TestFlight mail and run the lane again.
    build_number: context["buildNumber"].to_s,
    # The images, when there are any (#520). `metadata_path` points at the
    # generated folder, which holds none, so the screenshots are named
    # separately — they are captured, not generated, and they are not in git.
    #
    # `overwrite_screenshots` tracks the same answer rather than being an
    # option of its own: left false, deliver ADDS to what is already there and
    # a listing accumulates two versions of every screen.
    screenshots_path: SCREENSHOTS_DIR,
    skip_screenshots: !shots,
    overwrite_screenshots: shots,
    # Nothing is sent to review from here: the version record is created and
    # filled, and a human presses the button in App Store Connect.
    submit_for_review: false,
    run_precheck_before_submit: false,
    # No HTML preview to confirm — this has to run unattended.
    force: true,
  )
  UI.success(
    "Notes App Store déposées sur la version #{context['version']}, build " \
    "#{context['buildNumber']}#{shots ? ', captures comprises' : ''} " \
    "(pas soumise à la revue)."
  )
end

desc "Éléments à tester — TestFlight, par build"
lane :testflight_notes do
  context = build_context
  upload_to_testflight(
    api_key: asc_key,
    app_version: context["version"],
    # Named, never `--latest`: "the most recent build" and "the build we just
    # made" stop being the same thing after any build that did not ship.
    build_number: context["buildNumber"].to_s,
    # Without this, pilot asks "Please enter the app's platform" on stdin —
    # twice — and a run with no terminal hangs on the question.
    app_platform: "ios",
    distribute_only: true,
    changelog: read_notes(context["testflightNotesPath"]),
    # Setting a changelog goes through pilot's distribute path, so this lane
    # does hand the build to its TestFlight groups. For internal testers that
    # changes nothing — they receive every build automatically. External testers
    # are the ones who would be emailed, and pilot's default for that is *true*:
    # writing release notes must not, by itself, mail anybody.
    notify_external_testers: false,
  )
  UI.success("Éléments à tester déposés sur le build #{context['buildNumber']}.")
end

# supply matches a release by the versionCode it holds, and fails with a bare
# "Could not find release for version code 'N'" when none does — which says
# nothing about why. A release loses its bundle when it is promoted in the
# Console, so this is what a release promoted before its notes were written looks
# like. Answer the question the error does not.
def play_release_holding?(version_code, track_name, key)
  require "google/apis/androidpublisher_v3"
  require "googleauth"

  service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
  service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
    json_key_io: File.open(key),
    scope: "https://www.googleapis.com/auth/androidpublisher",
  )
  edit = service.insert_edit(PACKAGE)
  begin
    tracks = service.list_edit_tracks(PACKAGE, edit.id).tracks
    wanted = tracks.find { |t| t.track == track_name }
    held = (wanted&.releases || []).any? { |r| (r.version_codes || []).map(&:to_s).include?(version_code.to_s) }
    return true if held

    UI.error("Aucune release du canal #{track_name} ne porte le versionCode #{version_code}.")
    UI.error("Ce que la Play Console contient aujourd'hui :")
    tracks.each do |t|
      (t.releases || []).each do |r|
        codes = (r.version_codes || []).join(",")
        UI.error("  #{t.track.ljust(11)} #{r.name} (#{r.status}) versionCodes=#{codes.empty? ? '—' : codes}")
      end
    end
    UI.error("Une release perd son bundle quand elle est promue depuis la Console : " \
             "les notes se posent juste après `eas build --auto-submit`, avant toute promotion.")
    false
  ensure
    # Never committed: this edit only ever read.
    service.delete_edit(PACKAGE, edit.id)
  end
end

desc "Notes de version — Play Console, canal internal"
lane :android_notes do
  context = build_context
  shots = android_screenshots_ready?(context["androidMetadataPath"])
  unless shots
    UI.important(
      "Aucune capture Android — la fiche garde ses images actuelles. " \
      "`npm run store:screenshots -- android` si un écran a changé."
    )
  end
  key = File.join(MOBILE_DIR, "google-play-service-account.json")
  UI.user_error!("#{key} absent. Voir mobile/DISTRIBUTION.md.") unless File.exist?(key)
  unless play_release_holding?(context["versionCode"], "internal", key)
    UI.user_error!("Notes non déposées — voir ci-dessus.")
  end
  upload_to_play_store(
    json_key: key,
    package_name: PACKAGE,
    # The build is already on `internal`, put there by `eas build --auto-submit`.
    track: "internal",
    version_code: context["versionCode"].to_i,
    # Changelogs, and the screenshots when a capture has left some (#520).
    # The rest of the listing — description, icon, feature graphic — is still
    # not managed from here, and uploading a metadata folder that holds none of
    # it over the live one would wipe it. Hence the flags stay off one by one
    # rather than a blanket `skip_upload_metadata: false`.
    skip_upload_aab: true,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: !shots,
    skip_upload_changelogs: false,
    metadata_path: context["androidMetadataPath"],
  )
  UI.success(
    "Notes de version déposées sur le versionCode #{context['versionCode']}" \
    "#{shots ? ', captures comprises' : ''} (canal internal)."
  )
end

desc "Les trois champs, une fois les deux builds terminés"
lane :notes do
  # First, and before generate_notes interrogates EAS: an absent key should
  # stop this in a second rather than after a round trip.
  preflight
  generate_notes
  ios_notes
  testflight_notes
  android_notes
end
